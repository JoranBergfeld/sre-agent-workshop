{
  "$schema": "../../../schemas/placement.schema.json",
  "scenario": "azure-boards-copilot-handover",
  "description": "Python 3.12 Linux Functions on Consumption (Y1), Service Bus, Storage and monitoring, deployed at subscription scope into an operator-created {workload}-rg group.",
  "regions": [
    "eastus2",
    "swedencentral",
    "australiaeast"
  ],
  "defaultWorkload": "srelabboardshandover",
  "resourceGroup": "{workload}-rg",
  "groupTags": {
    "workshop": "sre-agent",
    "scenario": "azure-boards-copilot-handover",
    "environment": "demo"
  },
  "regionChecks": [
    {
      "type": "functionsConsumption"
    },
    {
      "type": "runtimeStack",
      "host": "functionapp",
      "stack": "python",
      "runtimeVersion": "Python|3.12",
      "functionsExtensionVersion": "~4"
    },
    {
      "type": "provider",
      "namespace": "Microsoft.Web",
      "resourceType": "serverFarms"
    },
    {
      "type": "provider",
      "namespace": "Microsoft.ServiceBus",
      "resourceType": "namespaces"
    },
    {
      "type": "provider",
      "namespace": "Microsoft.Storage",
      "resourceType": "storageAccounts"
    },
    {
      "type": "provider",
      "namespace": "Microsoft.Insights",
      "resourceType": "components"
    },
    {
      "type": "provider",
      "namespace": "Microsoft.OperationalInsights",
      "resourceType": "workspaces"
    }
  ],
  "legacyOwnership": {
    "description": "Verifiable tags/evidence written by earlier workshop versions; used only to re-adopt this scenario's own previous deployment.",
    "groupTags": {
      "scenario": "azure-boards-copilot-handover"
    },
    "resourceTags": {
      "scenario": "azure-boards-copilot-handover"
    }
  },
  "deployment": {
    "scope": "subscription",
    "template": "infra/bicep/main.bicep",
    "name": "azure-boards-copilot-handover-{workload}",
    "parameters": {
      "location": "{location}",
      "workloadName": "{workload}",
      "tags": "{groupTags}"
    }
  }
}
