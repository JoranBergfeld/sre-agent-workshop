{
  "$schema": "../../../schemas/placement.schema.json",
  "scenario": "cloud-agent-handover",
  "description": "Linux App Service B1 (.NET 10) with Application Insights and Log Analytics.",
  "regions": [
    "eastus2",
    "swedencentral",
    "australiaeast"
  ],
  "defaultWorkload": "srelabapp",
  "resourceGroup": "rg-{workload}",
  "groupTags": {
    "workshop": "sre-agent"
  },
  "regionChecks": [
    {
      "type": "appServiceLinux",
      "sku": "B1"
    },
    {
      "type": "runtimeStack",
      "host": "webapp",
      "stack": "dotnet",
      "runtimeVersion": "DOTNETCORE|10.0"
    },
    {
      "type": "provider",
      "namespace": "Microsoft.Web",
      "resourceType": "sites"
    },
    {
      "type": "provider",
      "namespace": "Microsoft.Insights",
      "resourceType": "components"
    },
    {
      "type": "provider",
      "namespace": "Microsoft.OperationalInsights",
      "resourceType": "workspaces"
    }
  ],
  "legacyOwnership": {
    "description": "Verifiable tags/evidence written by earlier workshop versions; used only to re-adopt this scenario's own previous deployment.",
    "groupTags": {
      "workshop": "sre-agent",
      "environment": "demo"
    },
    "resourceTags": {
      "workshop": "sre-agent"
    },
    "deployments": [
      {
        "name": "main",
        "outputs": [
          "webAppName",
          "webAppHostName",
          "logAnalyticsId"
        ]
      }
    ]
  },
  "deployment": {
    "scope": "group",
    "template": "infra/bicep/main.bicep",
    "name": "cloud-agent-handover-{workload}",
    "parameters": {
      "location": "{location}",
      "workloadName": "{workload}",
      "tags": {
        "workshop": "sre-agent",
        "environment": "demo"
      }
    }
  }
}
