#!/usr/bin/env bash
set -euo pipefail

if [ -n "${AZ_INJECT_TRACE:-}" ]; then
  printf '%s\n' "$*" >> "$AZ_INJECT_TRACE"
fi

if [ "${1:-}" = "account" ] && [ "${2:-}" = "show" ]; then
  echo "00000000-0000-0000-0000-000000000000"
  exit 0
fi

# Discovery calls made by the shared placement engine's fleet preflight. The
# group's metadata region (westeurope) intentionally differs from the region
# its workload actually runs in (swedencentral, recorded at deployment).
if [[ " $* " == *" --output json "* ]]; then
  case "${1:-} ${2:-}" in
    "group exists")
      if [ "${AZ_INJECT_NO_GROUP:-}" = "1" ]; then echo false; else echo true; fi ;;
    "group show")
      echo '{"location":"westeurope","tags":{"sre-workshop-scenario":"vm-size-retirement","sre-workshop-location":"swedencentral","sre-workshop-sku":"Standard_B2s"}}' ;;
    "resource list") echo '[]' ;;
    "vm list")
      echo '[{"name":"srelabretirement-vm01","size":"Standard_B2s","location":"swedencentral"},{"name":"srelabretirement-vm02","size":"Standard_B2s","location":"swedencentral"}]' ;;
    "vm list-skus")
      cap() { printf '[{"name":"vCPUs","value":"%s"},{"name":"MemoryGB","value":"8"},{"name":"CpuArchitectureType","value":"x64"},{"name":"PremiumIO","value":"True"},{"name":"HyperVGenerations","value":"V1,V2"},{"name":"DiskControllerTypes","value":"SCSI"}]' "$1"; }
      printf '[{"name":"Standard_B2s","family":"standardBSFamily","capabilities":%s,"restrictions":[]},{"name":"Standard_D2s_v5","family":"standardDSv5Family","capabilities":%s,"restrictions":[]},{"name":"Standard_D2as_v5","family":"standardDASv5Family","capabilities":%s,"restrictions":[]},{"name":"Standard_DS1_v2","family":"standardDSv2Family","capabilities":%s,"restrictions":[]},{"name":"Standard_DS2_v2","family":"standardDSv2Family","capabilities":%s,"restrictions":[]}]\n' "$(cap 2)" "$(cap 2)" "$(cap 2)" "$(cap 1)" "$(cap 2)" ;;
    "vm list-usage")
      # AZ_INJECT_FLEET_SHORT leaves 2 DSv2 vCPUs: not enough for the 4-vCPU legacy fleet.
      used=$([ "${AZ_INJECT_FLEET_SHORT:-}" = "1" ] && echo 18 || echo 0)
      printf '[{"name":{"value":"cores"},"currentValue":4,"limit":100},{"name":{"value":"standardBSFamily"},"currentValue":4,"limit":20},{"name":{"value":"standardDSv2Family"},"currentValue":%s,"limit":20},{"name":{"value":"standardDSv5Family"},"currentValue":0,"limit":20},{"name":{"value":"standardDASv5Family"},"currentValue":0,"limit":20}]\n' "$used" ;;
    *) echo "Unexpected Azure CLI injector fixture call: $*" >&2; exit 64 ;;
  esac
  exit 0
fi

if [ "${1:-}" = "vm" ] && [ "${2:-}" = "show" ]; then
  if [ "${AZ_INJECT_CREATE:-}" = "1" ]; then exit 3; fi
  exit 0
fi

if [ "${1:-}" = "network" ] && [ "${2:-}" = "nic" ] && [ "${3:-}" = "show" ]; then
  exit 3
fi

if [ "${1:-}" = "network" ] && [ "${2:-}" = "nic" ] && [ "${3:-}" = "create" ]; then
  exit 0
fi

if [ "${1:-}" = "vm" ] && [ "${2:-}" = "create" ]; then
  exit 0
fi

if [ "${1:-}" = "vm" ] && [ "${2:-}" = "resize" ]; then
  exit 0
fi

if [ "${1:-}" = "vm" ] && [ "${2:-}" = "deallocate" ]; then
  exit 0
fi

if [ "${1:-}" = "vm" ] && [ "${2:-}" = "wait" ]; then
  if [ "${AZ_INJECT_FAIL_DEALLOCATED:-}" = "1" ] && [[ " $* " == *" --deallocated "* ]]; then
    echo "simulated deallocated wait failure" >&2
    exit 42
  fi
  exit 0
fi

echo "Unexpected Azure CLI injector fixture call: $*" >&2
exit 64
