ContainerLogV2
| where PodNamespace == "cosmos-rbac-removal"
| where TimeGenerated > ago(1h)
| where LogMessage has "Failed to read items from CosmosDB" or LogMessage has "RBAC" or LogMessage has "Forbidden" or LogMessage has "StatusCode: 500"
| project TimeGenerated, PodName, ContainerName, LogMessage, LogLevel
| top 50 by TimeGenerated desc
