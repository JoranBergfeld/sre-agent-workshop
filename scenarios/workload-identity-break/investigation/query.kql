// Workload Identity Break — investigation query.
// Surfaces Azure AD token-exchange failures from this scenario's containers,
// pointing at a missing/misconfigured federated identity credential.
ContainerLogV2
| where PodNamespace == "workload-identity-break"
| where TimeGenerated > ago(1h)
| extend LogText = tostring(LogMessage)
| where LogText has "AADSTS70021" or LogText has "No matching federated identity" or LogText has "ManagedIdentityCredential" or LogText contains "AADSTS"
| project TimeGenerated, PodName, ContainerName, LogText, LogLevel
| top 50 by TimeGenerated desc
