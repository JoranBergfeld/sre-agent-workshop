// Workload Identity Break — investigation query.
// Surfaces Azure AD token-exchange failures from this scenario's containers,
// pointing at a missing/misconfigured federated identity credential.
ContainerLogV2
| where PodNamespace == "workload-identity-break"
| where TimeGenerated > ago(1h)
| where LogMessage has "AADSTS70021" or LogMessage has "No matching federated identity" or LogMessage has "ManagedIdentityCredential" or LogMessage contains "AADSTS"
| project TimeGenerated, PodName, ContainerName, LogMessage, LogLevel
| top 50 by TimeGenerated desc
