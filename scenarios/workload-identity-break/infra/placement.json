{
  "$schema": "../../../schemas/placement.schema.json",
  "scenario": "workload-identity-break",
  "description": "AKS system pool (2x 4-vCPU nodes plus 1 surge node), a regional standard-support Kubernetes version, Container Insights, workload identity and serverless Cosmos DB.",
  "regions": [
    "eastus2",
    "swedencentral",
    "australiaeast"
  ],
  "defaultWorkload": "srelabidentity",
  "resourceGroup": "rg-{workload}",
  "regionChecks": [
    {
      "type": "provider",
      "namespace": "Microsoft.ContainerService",
      "resourceType": "managedClusters"
    },
    {
      "type": "provider",
      "namespace": "Microsoft.DocumentDB",
      "resourceType": "databaseAccounts"
    },
    {
      "type": "provider",
      "namespace": "Microsoft.OperationalInsights",
      "resourceType": "workspaces"
    },
    {
      "type": "provider",
      "namespace": "Microsoft.Insights",
      "resourceType": "dataCollectionRules"
    },
    {
      "type": "aksVersion",
      "minVersion": "1.33"
    },
    {
      "type": "cosmos"
    }
  ],
  "compute": {
    "kind": "aks",
    "clusterName": "{workload}-aks",
    "count": 2,
    "surge": 1,
    "skus": [
      "Standard_D4ads_v6",
      "Standard_D4ads_v5",
      "Standard_D4s_v5",
      "Standard_D4as_v5"
    ],
    "requires": {
      "minVCPUs": 4,
      "maxVCPUs": 4,
      "minMemoryGB": 4,
      "architecture": "x64"
    }
  },
  "groupTags": {
    "workshop": "sre-agent",
    "scenario": "workload-identity-break",
    "environment": "demo"
  },
  "legacyOwnership": {
    "description": "Verifiable tags/evidence written by earlier workshop versions; used only to re-adopt this scenario's own previous deployment.",
    "groupTags": {
      "scenario": "workload-identity-break",
      "environment": "demo"
    },
    "resourceTags": {
      "scenario": "workload-identity-break"
    }
  },
  "deployment": {
    "scope": "group",
    "template": "infra/bicep/main.bicep",
    "name": "workload-identity-break-{workload}",
    "parameters": {
      "location": "{location}",
      "workloadName": "{workload}",
      "systemNodeVmSize": "{sku}",
      "kubernetesVersion": "{kubernetesVersion}",
      "tags": {
        "workshop": "sre-agent",
        "environment": "demo"
      }
    }
  }
}
