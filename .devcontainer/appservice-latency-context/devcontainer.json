{
  "name": "SRE Scenario — App Service Latency Context",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/azure-cli:1": { "installBicep": true },
    "ghcr.io/devcontainers/features/powershell:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y php-cli curl unzip openssl",
  "postCreateCommand": "npm --prefix scripts/scenario-tools ci && az extension add --name log-analytics",
  "forwardPorts": [8080],
  "hostRequirements": { "cpus": 4 },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-bicep",
        "ms-vscode.azurecli",
        "ms-vscode.powershell",
        "github.vscode-github-actions",
        "redhat.vscode-yaml",
        "github.copilot",
        "github.copilot-chat"
      ]
    }
  }
}
