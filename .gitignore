# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
infra/bicep/main.json
scenarios/*/infra/bicep/main.json
node_modules/

# App Service scenario: .NET build artifacts
scenarios/cloud-agent-handover/src/bin/
scenarios/cloud-agent-handover/src/obj/
scenarios/cloud-agent-handover/tests/bin/
scenarios/cloud-agent-handover/tests/obj/
scenarios/cloud-agent-handover/**/TestResults/

# Azure Boards Copilot Handover scenario: Python build/tooling artifacts
scenarios/azure-boards-copilot-handover/app/.venv/
scenarios/azure-boards-copilot-handover/app/__pycache__/
scenarios/azure-boards-copilot-handover/app/**/__pycache__/
scenarios/azure-boards-copilot-handover/app/.pytest_cache/
scenarios/azure-boards-copilot-handover/app/.ruff_cache/
scenarios/azure-boards-copilot-handover/app/.mypy_cache/
scenarios/azure-boards-copilot-handover/app/.coverage
scenarios/azure-boards-copilot-handover/app/uv.lock

# Azure Boards Copilot Handover lifecycle test scratch space
scripts/scenario-tools/test/.tmp-lifecycle-scratch/
